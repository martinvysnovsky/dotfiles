{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5",
  "share": "disabled",
  "autoupdate": true,
  "lsp": true,
  "formatter": true,
  "plugin": ["opencode-gemini-auth@latest", "opencode-claude-auth@latest"],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "instructions": [
    "rules/agent-guidelines.md",
    "rules/code-standards.md",
    "rules/error-handling.md",
    "rules/frontend-standards.md",
    "rules/testing-standards.md"
  ],
  "agent": {
    "build": {
      "description": "Full development work with all tools enabled",
      "mode": "primary",
      "enable1mContext": true,
      "model": "anthropic/claude-opus-5",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude. Keep responses focused, brief, and concise; spend most of the response on the main answer and keep caveats short. During agentic work, give a brief update only when you find something important or change direction, and lead your final message with the outcome. Deliver what was asked at the scope intended: make routine judgment calls yourself, finish the whole task, and stop short of actions clearly beyond the request. Trust your own self-verification and self-correction; do not add separate re-check or re-verification passes. Delegate to a subagent only for large, genuinely independent, parallelizable work, never to verify your own work.",
      "tools": {
        "*": false,
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "patch": true,
        "todowrite": true,
        "todoread": true,
        "webfetch": true,
        "task": true,
        "skill": true,
        "mcp-gateway_*": false,
        "mcp-gateway_jira_*": true,
        "mcp-gateway_bitbucket_*": true,
        "mcp-gateway_obsidian_*": true,
        "pencil_*": false,
        "mui_*": true,
        "worktree_*": true
      },
      "permission": {
        "external_directory": {
          "~/obsidian/**": "allow",
          "~/www/**": "allow",
          "/tmp/**": "allow",
          "~/.config/opencode/**": "allow",
          "~/.local/share/opencode/tool-output/**": "allow",
          "~/services/mcp-shared/**": "allow"
        }
      }
    },
    "plan": {
      "description": "Analysis and planning without making changes",
      "mode": "primary",
      "model": "anthropic/claude-opus-5",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude. Keep responses focused, brief, and concise; spend most of the response on the main answer and keep caveats short. When explaining, give a high-level summary unless an in-depth explanation is specifically requested. Scope analysis to what was asked, and trust your own reasoning rather than adding redundant re-verification passes. Delegate to a subagent only for large, genuinely independent, parallelizable investigation.",
      "tools": {
        "*": false,
        "write": false,
        "edit": false,
        "bash": true,
        "patch": false,
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "todowrite": true,
        "todoread": true,
        "webfetch": true,
        "task": true,
        "skill": true,
        "reference_*": true,
        "mcp-gateway_*": false,
        "mui_*": true,
        "mcp-gateway_jira_*": true,
        "mcp-gateway_confluence_*": true,
        "mcp-gateway_sentry_*": true,
        "mcp-gateway_firecrawl_*": true,
        "mcp-gateway_obsidian_*": true,
        "mcp-gateway_bitbucket_*": true,
        "pencil_*": false
      },
      "permission": {
        "external_directory": {
          "~/www/**": "allow",
          "~/obsidian/**": "allow",
          "/tmp/**": "allow",
          "~/.local/share/opencode/tool-output/**": "allow",
          "~/.config/opencode/**": "allow",
          "~/.local/share/opencode/plans/**": "allow",
          "~/services/mcp-shared/**": "allow"
        }
      }
    },
    "browser-automation": {
      "description": "Browser automation and web testing with agent-browser",
      "mode": "subagent",
      "model": "anthropic/claude-haiku-4-5-20251001",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude.",
      "tools": {
        "*": false,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true,
        "mcp-gateway_*": false,
        "pencil_*": false
      }
    }
  },
  "mcp": {
    "mcp-gateway": {
      "type": "remote",
      "url": "http://localhost:8888/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 60000,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/mcp-gateway-token}"
      }
    },
    "pencil": {
      "type": "local",
      "command": ["pencil-mcp"],
      "enabled": true
    },
    "mui": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": true
    }
  },
  "provider": {
    "google": {
      "options": {
        "projectId": "98761157302"
      }
    }
  }
}
